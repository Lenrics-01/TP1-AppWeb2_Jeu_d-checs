# Configuration de DÉVELOPPEMENT. Copier en ".env" à la racine du dépôt
# (ou lancer ./setup.sh). Lu par l'API (node --env-file) et le client (vite.config.js).
# Le vrai .env ne va jamais dans le dépôt (.gitignore).

# Application GitHub OAuth de développement
# Authorization callback URL : http://localhost:3000/login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

SESSION_SECRET=secret-de-developpement

# Où le client trouve l'API (l'API écoute sur le port 4000 par défaut)
API_URL=http://localhost:4000

# Connexion sans GitHub (formulaire sur /login) pour tester à deux joueurs sur un seul poste
DEV_LOGIN=true

# Ajoute quelques joueurs fictifs au classement
SEED_DB=true
