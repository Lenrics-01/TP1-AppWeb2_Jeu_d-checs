# Copier ce fichier en ".env" dans le même dossier que compose.yml, puis remplir.
# Le vrai .env contient des secrets : il ne va JAMAIS dans le dépôt.

# --- Images à démarrer (ghcr.io/<GHCR_OWNER>/<IMAGE_NAME>-server:<TAG>)
GHCR_OWNER=lenrics-01
IMAGE_NAME=tp1-appweb2-jeu-d-checs
# Le tag sha- publié par la CI pour le commit marqué v1 (pas "latest" :
# latest change à chaque push, sha-xxxxxxx désigne une version précise).
TAG=sha-0000000

# --- Port de la machine sur lequel le site est accessible
PORT=3000

# --- Application GitHub OAuth (github.com/settings/developers)
# Authorization callback URL : http://localhost:3000/login
GITHUB_CLIENT_ID=Ov23liExempleExemple
GITHUB_CLIENT_SECRET=exemple0123456789abcdef0123456789abcdef

# --- Clé qui signe le cookie de session. Longue et aléatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=remplacer-par-une-longue-chaine-aleatoire

# true seulement si le site est servi en HTTPS
COOKIE_SECURE=false
